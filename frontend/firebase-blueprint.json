{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user profile and role information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Prediction": {
      "title": "Crop Prediction",
      "description": "Stores a single crop prediction result and its inputs.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "inputs": {
          "type": "object",
          "properties": {
            "temperature": { "type": "number" },
            "humidity": { "type": "number" },
            "rainfall": { "type": "number" },
            "soilType": { "type": "string" },
            "ph": { "type": "number" },
            "nitrogen": { "type": "number" },
            "phosphorus": { "type": "number" },
            "potassium": { "type": "number" }
          }
        },
        "result": {
          "type": "object",
          "properties": {
            "crop": { "type": "string" },
            "confidence": { "type": "number" },
            "advice": { "type": "string" }
          }
        }
      },
      "required": ["userId", "timestamp", "inputs", "result"]
    },
    "SystemStats": {
      "title": "System Statistics",
      "description": "Global statistics for the admin panel.",
      "type": "object",
      "properties": {
        "totalPredictions": { "type": "number" },
        "lastPredictionAt": { "type": "string", "format": "date-time" },
        "activeUsers": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents."
    },
    "/predictions/{predictionId}": {
      "schema": "Prediction",
      "description": "All crop predictions."
    },
    "/system_stats/usage": {
      "schema": "SystemStats",
      "description": "Global usage statistics."
    }
  }
}
